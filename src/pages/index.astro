---
import Base from '../layouts/Base.astro';
import {
  links, phone, address, rating, slots, prices, pricesNote, extras,
  texts, faq, legal, gammaPresets, beforeAfter, rub,
} from '../data/site';

// Акции: каждый .md в src/promos — одна акция. Файлы с «_» в начале пропускаем.
const promoFiles = import.meta.glob<any>('../promos/*.md', { eager: true });
const today = new Date().toISOString().slice(0, 10);
const promos = Object.entries(promoFiles)
  .filter(([path]) => !path.split('/').pop()!.startsWith('_'))
  .map(([, mod]) => mod)
  .filter(({ frontmatter: f }) => f.active !== false && (!f.until || new Date(f.until).toISOString().slice(0, 10) >= today))
  .sort((a, b) => (a.frontmatter.order ?? 99) - (b.frontmatter.order ?? 99));
const strip = promos.find(({ frontmatter: f }) => f.kind === 'временная');

// Длинный ответ в админке пишется абзацами через пустую строку
const paragraphs = (t: string) => t.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
---
<Base
  title="HYGGE — студия автопортрета в Тюмени"
  description="Фотостудия, где не нужен фотограф: 45 или 90 минут наедине с большим зеркалом и пультом. Форматы CLASSIC и GAMMA, фото через час на Яндекс Диске."
>
  {strip && (
    <a class="strip" href="#promos"><strong>{strip.frontmatter.title}</strong></a>
  )}

  <!-- Первый экран -->
  <section class="hero">
    <div class="wrap hero__in">
      <h1 class="hero__title">
        <span><span>Фотостудия,</span></span>
        <span><span>где не нужен</span></span>
        <span><span>фотограф</span></span>
      </h1>
      <div class="hero__media finder">
        <video autoplay muted loop playsinline preload="metadata" poster="/media/video/gamma-6806-poster.webp" width="720" height="1280" aria-label="Гость переключает цвет света на планшете">
          <source src="/media/video/gamma-6806-loop.mp4" type="video/mp4" />
        </video>
        <p class="hand hero__note">свет меняете вы</p>
      </div>
      <div class="hero__text">
        <p class="lead">{texts.hero.lead}</p>
        <div class="btns">
          <a class="btn btn--wine" href={links.booking} target="_blank" rel="noopener">Записаться</a>
          <a class="btn" href="#how">Как это работает</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Как это работает -->
  <section class="section" id="how">
    <div class="wrap">
      <h2>Как это работает</h2>
      <div class="how">
        <ol class="steps">
          {texts.how.map((st) => <li><h3>{st.title}</h3><p>{st.text}</p></li>)}
        </ol>
        <button class="video-card" type="button" data-video="/media/video/kak-720.mp4" data-poster="/media/video/kak-poster.webp">
          <img src="/media/video/kak-poster.webp" alt="" width="720" height="1280" loading="lazy" />
          <span class="video-card__play">Как это работает</span>
        </button>
      </div>
    </div>
  </section>

  <!-- Манифест и приватность -->
  <section class="section dark" id="about">
    <div class="wrap">
      <p class="manifesto" data-fill>
        {texts.manifesto.split(' ').map((w) => <span>{w} </span>)}
      </p>
      <p class="hygge">
        <span class="hand">hygge</span>
        {texts.hygge}
      </p>

      <h2 class="dark__h">Только вы и зеркало</h2>
      <ul class="facts">
        {texts.privacy.map((f) => <li><h3>{f.title}</h3><p>{f.text}</p></li>)}
      </ul>
    </div>
  </section>

  <!-- Для кого -->
  <section class="who">
    <div class="wrap">
      <p class="who__h">{texts.audience.intro}</p>
      <ul class="chips">{texts.audience.list.map((a) => <li>{a}</li>)}</ul>
    </div>
  </section>

  <!-- Форматы -->
  <section class="section" id="formats">
    <div class="wrap">
      <h2>Два формата съёмки</h2>
      <article class="classic">
        <h3 class="format-name">CLASSIC</h3>
        <p class="lead">{texts.classic.lead}</p>
        <ul class="swatches" aria-label="Фоны">
          <li><span style="background:#fff"></span>Белый</li>
          <li><span style="background:#000"></span>Чёрный</li>
          <li><span style="background:#c51f26"></span>Красный</li>
        </ul>
        <p>{texts.classic.text}</p>
      </article>
    </div>

    <article class="gamma" id="gamma" data-ink={gammaPresets[1].ink} style={`--g:${gammaPresets[1].bg}`}>
      <div class="wrap">
        <h3 class="format-name">GAMMA</h3>
        <p class="lead">{texts.gamma.lead}</p>
        <div class="presets" role="group" aria-label="Пресеты света">
          {gammaPresets.map((p, i) => (
            <button type="button" data-bg={p.bg} data-ink={p.ink} aria-pressed={i === 1 ? 'true' : 'false'}>{p.name}</button>
          ))}
        </div>
        <p class="gamma__count"><strong>{texts.gamma.count}</strong> {texts.gamma.countText}</p>
        <p>{texts.gamma.people}</p>
        <button class="btn gamma__video" type="button" data-video="/media/video/gamma-6812-720.mp4" data-poster="/media/video/gamma-6812-poster.webp">Посмотреть формат GAMMA</button>
      </div>
    </article>
  </section>

  <!-- ИИ-кадрирование и ч/б -->
  <section class="section" id="extras">
    <div class="wrap">
      <h2>ИИ-кадрирование и ч/б</h2>
      <p class="lead">{texts.extras.lead}</p>
      <p class="lead extras__private">{texts.extras.private}</p>
      <p class="hand ba-hint">
        <svg viewBox="0 0 40 40" width="34" height="34" aria-hidden="true"><path d="M8 6c14 2 22 12 22 26m0 0-7-6m7 6 5-8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Нажмите на фото, чтобы сравнить
      </p>
    </div>
    <ul class="ba" id="ba" aria-label="Примеры до и после">
      {beforeAfter.map(({ n, alt }) => (
        <li>
          <button type="button" class="ba__card" aria-pressed="false" aria-label={`${alt}: показать после обработки`}>
            <img src={`/media/ba/pair-${n}-before.webp`} alt={`${alt}, до обработки`} width="740" height="1112" loading="lazy" />
            <img class="ba__after" src={`/media/ba/pair-${n}-after.webp`} alt={`${alt}, после ИИ-кадрирования и ч/б`} width="740" height="1112" loading="lazy" />
            <span class="hand ba__label"><span class="ba__b">до</span><span class="ba__a">после</span></span>
          </button>
        </li>
      ))}
    </ul>
    <div class="wrap ba-nav">
      <button type="button" class="ba-nav__btn" data-dir="-1" aria-label="Предыдущие фото"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <input type="range" class="ba-nav__range" min="0" max="1000" value="0" aria-label="Пролистать примеры" aria-controls="ba" />
      <button type="button" class="ba-nav__btn" data-dir="1" aria-label="Следующие фото"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>
    <div class="wrap">
      <ul class="extras">
        {extras.map((e) => (
          <li>
            <div><h3>{e.name}</h3><p class="muted">Вы получите папки: {e.folders}</p></div>
            <strong>+{rub(e.price)}</strong>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Цены -->
  <section class="section prices-sec" id="prices">
    <div class="wrap">
      <h2>Цены</h2>
      <div class="slots">
        {slots.map((s) => (
          <div><strong>{s.photos}</strong><span>фото в среднем за {s.minutes} минут</span></div>
        ))}
      </div>
      <table class="prices">
        <thead><tr><th scope="col">Формат</th><th scope="col">45 мин</th><th scope="col">90 мин</th></tr></thead>
        <tbody>
          {prices.map((p) => (
            <tr><th scope="row">{p.format}<small>{p.note}</small></th><td>{rub(p.p45)}</td><td>{rub(p.p90)}</td></tr>
          ))}
        </tbody>
      </table>
      {pricesNote && <p class="muted prices__note">{pricesNote}</p>}
      <a class="btn btn--wine" href={links.booking} target="_blank" rel="noopener">Выбрать время</a>
    </div>
  </section>

  <!-- Сертификаты -->
  <section class="section cert" id="certificates">
    <div class="wrap">
      <h2>Подарочный сертификат</h2>
      <p class="lead">{texts.certificate.lead}</p>
      <ul class="ways">
        {texts.certificate.ways.map((w) => <li><h3>{w.title}</h3><p>{w.text}</p></li>)}
      </ul>
      <div class="btns">
        <a class="btn btn--ink" href={links.certificateBuy} target="_blank" rel="noopener">Купить сертификат</a>
        <details class="pick">
          <summary class="btn">Написать нам</summary>
          <div class="pick__list">
            <a href={links.telegram} target="_blank" rel="noopener">Telegram</a>
            <a href={links.max} target="_blank" rel="noopener">Max</a>
            <a href={links.vk} target="_blank" rel="noopener">ВКонтакте</a>
          </div>
        </details>
        {phone && <a class="btn" href={`tel:${phone.tel}`}>Позвонить нам</a>}
      </div>
      <details class="cert__how">
        <summary>Как записаться по сертификату<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M5 9l7 7 7-7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
        <ol>{texts.certificate.steps.map((st) => <li>{st}</li>)}</ol>
        <a class="btn btn--wine" href={links.booking} target="_blank" rel="noopener">Записаться по сертификату</a>
      </details>
    </div>
  </section>

  <!-- Акции -->
  {promos.length > 0 && (
    <section class="section promos-sec" id="promos">
      <div class="wrap">
        <h2>Акции</h2>
        <div class="promos">
          {promos.map(({ frontmatter: f, Content }) => (
            <article>
              <h3>{f.title}</h3>
              <Content />
              {f.until && <p class="muted">До {new Date(f.until).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long' })}</p>}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Отзывы -->
  <section class="section" id="reviews">
    <div class="wrap reviews">
      <div>
        <h2>Отзывы</h2>
        <p class="score"><strong>{rating.value}</strong><span>{rating.votes} оценки и {rating.reviews} отзывов в 2ГИС</span></p>
        <a class="btn" href={links.gis} target="_blank" rel="noopener">Все отзывы в 2ГИС</a>
      </div>
      <div class="gis" data-gis><p class="muted">Загружаем отзывы из 2ГИС…</p></div>
    </div>
  </section>

  <!-- Вопросы -->
  <section class="section" id="faq">
    <div class="wrap">
      <h2>Вопросы</h2>
      <div class="faq">
        {faq.map((f) => (
          <details><summary>{f.q}</summary>{paragraphs(f.a).map((p) => <p>{p}</p>)}</details>
        ))}
      </div>
    </div>
  </section>

  <!-- Адрес и контакты -->
  <section class="section address" id="address">
    <div class="wrap address__in">
      <div>
        <h2>{address.street}</h2>
        <p class="lead">{address.city}, {address.floor}. {address.howToFind}</p>
        <p class="muted">{address.hours}</p>
        <div class="btns">
          <a class="btn btn--ink" href={links.gis} target="_blank" rel="noopener">Открыть в 2ГИС</a>
          <a class="btn" href={links.yandex} target="_blank" rel="noopener">Яндекс Карты</a>
        </div>
      </div>
      <ul class="contacts">
        <li><a href={links.telegram} target="_blank" rel="noopener">Telegram</a></li>
        <li><a href={links.max} target="_blank" rel="noopener">Max</a></li>
        <li><a href={links.vk} target="_blank" rel="noopener">ВКонтакте</a></li>
        {phone && <li><a href={`tel:${phone.tel}`}>{phone.display}</a></li>}
        <li><a href={`mailto:${address.email}`}>{address.email}</a></li>
      </ul>
    </div>
    <footer class="wrap foot muted">
      <p>© HYGGE, студия автопортрета, Тюмень</p>
      <p>{legal.name}<br />ИНН {legal.inn} · ОГРНИП {legal.ogrnip}</p>
    </footer>
  </section>

  <dialog class="player" aria-label="Видео">
    <video controls playsinline></video>
    <form method="dialog"><button class="player__close" aria-label="Закрыть">×</button></form>
  </dialog>
</Base>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Манифест: слова «проявляются» по мере прокрутки
  const fill = document.querySelector<HTMLElement>('[data-fill]');
  if (fill) {
    const words = [...fill.children] as HTMLElement[];
    const paint = () => {
      const r = fill.getBoundingClientRect();
      const vh = innerHeight;
      const p = reduce ? 1 : Math.min(1, Math.max(0, (vh * 0.85 - r.top) / (r.height + vh * 0.35)));
      const lit = p * words.length;
      // мягкий край в 3 слова
      words.forEach((w, i) => w.style.setProperty('--o', String(Math.min(1, Math.max(0, (lit - i) / 3)))));
    };
    paint();
    addEventListener('scroll', () => requestAnimationFrame(paint), { passive: true });
  }

  // GAMMA: пресеты меняют свет блока
  const gamma = document.querySelector<HTMLElement>('.gamma');
  gamma?.querySelectorAll<HTMLButtonElement>('.presets button').forEach((b) => {
    b.addEventListener('click', () => {
      gamma.style.setProperty('--g', b.dataset.bg!);
      gamma.dataset.ink = b.dataset.ink!;
      gamma.querySelectorAll('.presets button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    });
  });

  // До / после: нажатие переключает кадр
  document.querySelectorAll<HTMLButtonElement>('.ba__card').forEach((c) => {
    c.addEventListener('click', () => c.setAttribute('aria-pressed', String(c.getAttribute('aria-pressed') !== 'true')));
  });

  // Лента «до / после»: бегунок и стрелки синхронизированы с прокруткой
  const ba = document.querySelector<HTMLElement>('#ba');
  const range = document.querySelector<HTMLInputElement>('.ba-nav__range');
  if (ba && range) {
    const max = () => ba.scrollWidth - ba.clientWidth;
    const sync = () => {
      range.value = String(max() > 0 ? Math.round((ba.scrollLeft / max()) * 1000) : 0);
    };
    ba.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
    addEventListener('resize', sync);
    sync();
    range.addEventListener('input', () => {
      ba.style.scrollSnapType = 'none';
      ba.scrollLeft = (Number(range.value) / 1000) * max();
    });
    range.addEventListener('change', () => { ba.style.scrollSnapType = ''; });
    document.querySelectorAll<HTMLButtonElement>('.ba-nav__btn').forEach((b) => {
      b.addEventListener('click', () => {
        const card = ba.querySelector('li')!.getBoundingClientRect().width + 12;
        ba.scrollBy({ left: Number(b.dataset.dir) * card, behavior: reduce ? 'auto' : 'smooth' });
      });
    });
  }

  // «Написать нам»: закрываем список при нажатии мимо него
  const pick = document.querySelector<HTMLDetailsElement>('.pick');
  document.addEventListener('click', (e) => { if (pick?.open && !pick.contains(e.target as Node)) pick.open = false; });

  // Видео в модальном окне
  const dialog = document.querySelector<HTMLDialogElement>('.player')!;
  const player = dialog.querySelector('video')!;
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((b) => {
    b.addEventListener('click', () => {
      player.poster = b.dataset.poster ?? '';
      player.src = b.dataset.video!;
      dialog.showModal();
      player.play().catch(() => {});
    });
  });
  dialog.addEventListener('close', () => { player.pause(); player.removeAttribute('src'); player.load(); });
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });

  // Виджет отзывов 2ГИС — грузим, только когда до него долистали
  const gis = document.querySelector<HTMLElement>('[data-gis]');
  if (gis) {
    const load = () => {
      const frame = document.createElement('iframe');
      frame.title = 'Отзывы о HYGGE в 2ГИС';
      frame.setAttribute('sandbox', 'allow-modals allow-forms allow-scripts allow-same-origin allow-popups allow-top-navigation-by-user-activation');
      gis.replaceChildren(frame);
      const s = 'script';
      const doc = frame.contentWindow!.document;
      doc.open();
      doc.write(`<head><${s}>window.__size__='big';window.__theme__='light';window.__branchId__='70000001076935631';window.__orgId__='70000001076935630'</${s}>`
        + `<${s} crossorigin="anonymous" type="module" src="https://disk.2gis.com/widget-constructor/assets/iframe.js"></${s}>`
        + `<link rel="modulepreload" crossorigin="anonymous" href="https://disk.2gis.com/widget-constructor/assets/defaults.js">`
        + `<link rel="stylesheet" crossorigin="anonymous" href="https://disk.2gis.com/widget-constructor/assets/defaults.css"></head><body><div id="iframe"></div></body>`);
      doc.close();
    };
    new IntersectionObserver((entries, io) => {
      if (entries.some((e) => e.isIntersecting)) { io.disconnect(); load(); }
    }, { rootMargin: '600px' }).observe(gis);
  }
</script>

<style>
  .strip {
    display: block; padding: 12px var(--gutter); text-align: center;
    background: var(--wine); color: #fff; text-decoration: none; font-size: 15px;
  }

  /* Первый экран */
  .hero { padding: 28px 0 56px; }
  .hero__in { display: grid; gap: 28px; }
  .hero__title { font-size: clamp(46px, 14.2vw, 116px); line-height: .9; letter-spacing: -0.055em; font-weight: 850; }
  .hero__title > span { display: block; overflow: hidden; padding-bottom: .04em; }
  .hero__title > span > span { display: block; animation: rise 1s cubic-bezier(.2,.7,.1,1) both; }
  .hero__title > span:nth-child(2) > span { animation-delay: .11s; }
  .hero__title > span:nth-child(3) > span { animation-delay: .22s; }
  @keyframes rise { from { transform: translateY(105%); } }

  .hero__media { margin: 10px; }
  .hero__media video { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; object-position: 50% 60%; background: #2326e6; }
  .hero { padding-top: 20px; }
  .hero__in { gap: 22px; }
  .hero__note {
    position: absolute; z-index: 3; right: 14px; bottom: 12px;
    font-size: 26px; color: #fff; transform: rotate(-4deg);
  }
  .hero__text { display: grid; gap: 24px; }

  @media (min-width: 1024px) {
    .hero { padding: 56px 0 120px; }
    .hero__in { grid-template-columns: 1.25fr 1fr; grid-template-rows: auto 1fr; column-gap: 64px; row-gap: 40px; align-items: start; }
    .hero__media { grid-column: 2; grid-row: 1 / span 2; margin: 10px 10px 10px 0; }
    .hero__media video { aspect-ratio: 3 / 4; }
    .hero__text { align-self: end; }
  }

  /* Как это работает */
  .how { display: grid; gap: 40px; }
  .steps { list-style: none; margin: 0; padding: 0; counter-reset: s; display: grid; gap: 28px; }
  .steps li { counter-increment: s; display: grid; grid-template-columns: 44px 1fr; column-gap: 12px; row-gap: 6px; }
  .steps li::before {
    content: counter(s); grid-row: span 2;
    font-family: var(--hand); color: var(--wine); font-size: 40px; line-height: .9;
  }
  .steps p { color: var(--mute); }
  .video-card {
    position: relative; padding: 0; border: 0; background: #000; cursor: pointer;
    width: 100%; max-width: 360px; justify-self: center; border-radius: 4px; overflow: hidden;
  }
  .video-card img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; opacity: .82; }
  .video-card__play {
    position: absolute; left: 12px; right: 12px; bottom: 12px;
    display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 52px;
    background: #fff; color: #000; border-radius: 999px; font: 600 16px var(--sans);
  }
  .video-card__play::before { content: ''; border-left: 12px solid currentColor; border-block: 7px solid transparent; }
  @media (min-width: 1024px) {
    .how { grid-template-columns: 1.4fr 1fr; gap: 80px; align-items: start; }
    .steps { gap: 40px; }
  }

  /* Тёмная секция */
  .dark { background: #000; color: #fff; }
  .manifesto {
    font-size: clamp(30px, 8.4vw, 64px); font-weight: 700; line-height: 1.12; letter-spacing: -0.035em;
    max-width: 16em;
  }
  .manifesto span { color: color-mix(in srgb, #fff calc(var(--o, 0) * 100%), #575757); transition: color .25s; }
  .hygge { margin-top: 40px; max-width: 32em; color: #b5b5b5; font-size: 17px; }
  .hygge .hand { display: block; font-size: 40px; color: #fff; margin-bottom: 4px; }
  .dark__h { margin: 88px 0 28px; }
  .facts { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .facts li { padding: 22px 0; border-top: 1px solid #2c2c2c; display: grid; gap: 6px; }
  .facts p { color: #a8a8a8; }
  @media (min-width: 1024px) {
    .facts { grid-template-columns: 1fr 1fr; column-gap: 64px; }
    .dark__h { margin-top: 140px; }
  }

  /* Для кого */
  .who { padding: 56px 0; border-bottom: 1px solid var(--line); }
  .who__h { font-size: 20px; font-weight: 600; letter-spacing: -0.015em; max-width: 30em; margin-bottom: 20px; }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
