---
import Base from '../layouts/Base.astro';
---
<Base title="Страница не найдена — HYGGE" description="Такой страницы нет на сайте студии автопортрета HYGGE.">
  <section class="nf">
    <div class="wrap">
      <p class="hand nf__note">кадр не получился</p>
      <h1>Такой страницы нет</h1>
      <p class="lead">Возможно, ссылка устарела. Всё о студии — на главной.</p>
      <a class="btn btn--wine" href="/">На главную</a>
    </div>
  </section>
</Base>

<style>
  .nf { padding: 72px 0 96px; }
  .nf .wrap { display: grid; gap: 20px; justify-items: start; }
  .nf h1 { font-size: clamp(44px, 12vw, 96px); letter-spacing: -0.05em; }
  .nf__note { font-size: 30px; transform: rotate(-3deg); }
</style>
